   "number_of_periods": 1000,
   "grating_period": 0.316,
   "gap": 0.1,
   "corrugation1_width": 0.05,
   "corrugation2_width": 0.025,
   "AR": true,
   "sinusoidal": false,
   "wg1_width": 0.56,
   "wg2_width": 0.44,
   "sbend": true,
   "sbend_r": 15.0,
   "sbend_length": 11.0,
